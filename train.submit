#!/bin/bash
#SBATCH --time=1440
#SBATCH --job-name=SynthDiaSG_Matcha_TTS
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=20
#SBATCH --nodes=1
#SBATCH --partition=gpu
#SBATCH --mem=40G
#SBATCH --gres=gpu:1
