#!/bin/bash
#SBATCH --time=1440
#SBATCH --job-name=SynthDiaSG_Matcha_TTS
#SBATCH --ntasks-per-node=2
#SBATCH --cpus-per-task=10
#SBATCH --nodes=1
#SBATCH --partition=gpu
#SBATCH --mem=20G
#SBATCH --gres=gpu:v100sxm:2
#SBATCH --account=cai_nlp
#SBATCH --mail-user=saaf@zhaw.ch
#SBATCH --output=/cluster/home/saaf/PHD/Matcha-TTS/logs/%j_%N.out
#SBATCH --error=/cluster/home/saaf/PHD/Matcha-TTS/logs/%j_%N.err
#SBATCH --signal=B:SIGUSR1@60

export UV_PROJECT_ENVIRONMENT='/raid/persistent_scratch/saaf/venvs/phd'
export UV_LINK_MODE=copy

uv lock
uv sync --frozen --extra wandb --extra espeak

srun uv run matcha/train.py experiment=ljspeech +trainer.max_steps=50000 trainer.devices=2 trainer=gpu data.num_workers=10 logger=wandb test=False